    <string name="about_feat_holidays_desc">Feriados de dez países, calculados no próprio dispositivo: Áustria, Bélgica, França, Alemanha, Itália, Luxemburgo, Espanha, Suíça, Reino Unido e Estados Unidos.</string>
    <string name="about_feat_share_label">Compartilhamento e mapas</string>
    <string name="about_feat_share_desc">Compartilhe um evento como texto ou arquivo .ics e abra seu endereço no aplicativo de mapas de sua preferência — o Agenda Tech não envia nenhuma informação por conta própria. Excluiu algo por engano? Use Desfazer para restaurar.</string>
    <string name="about_feat_recurrence_label">Eventos recorrentes</string>
    <string name="about_feat_recurrence_desc">Repetições diárias, semanais, mensais ou anuais, intervalos personalizados e data de término; todo mês por data ou por posição (a segunda terça-feira, a última sexta-feira, o último dia) — edite uma única ocorrência ou toda a série.</string>
    <string name="about_feat_reminders_label">Lembretes</string>
    <string name="about_feat_reminders_desc">Alarmes exatos, horários personalizados e toque de sua preferência. Os lembretes são reativados após a reinicialização do dispositivo.</string>
    <string name="about_feat_import_label">Importação / exportação</string>
    <string name="about_feat_import_desc">Copie os eventos já armazenados neste dispositivo (Google, Exchange…) ou troque arquivos .ics — tudo sem conexão com a Internet.</string>
    <string name="about_feat_widgets_label">Widgets da tela inicial</string>
    <string name="about_feat_widgets_desc">Exibe os próximos eventos e um ícone compacto com a data.</string>
    <string name="about_feat_lock_label">Bloqueio por PIN / biometria</string>
    <string name="about_feat_lock_desc">Bloqueio opcional de todo o aplicativo, com proteção contra tentativas de força bruta.</string>
    <string name="about_feat_encryption_label">Armazenamento criptografado</string>
    <string name="about_feat_encryption_desc">Todo o banco de dados é criptografado com AES-256; a chave nunca sai do hardware seguro do dispositivo.</string>
    <string name="about_feat_theme_label">Temas claro e escuro</string>
    <string name="about_feat_theme_desc">Segue o tema do sistema ou permite selecionar um tema específico. Números das semanas, primeiro dia da semana e cor padrão.</string>
    <string name="about_feat_languages_label">Seis idiomas</string>
    <string name="about_feat_languages_desc">Inglês, francês, alemão, italiano, espanhol e português do Brasil — selecionáveis individualmente para o aplicativo a partir do Android 13.</string>

    <!-- Sobre · Segurança -->
    <string name="about_security_title">Segurança</string>
    <string name="about_security_card_title">Criptografia em repouso</string>
    <string name="about_security_body">O banco de dados (SQLCipher, AES-256) é criptografado com uma chave aleatória protegida pelo Android Keystore — respaldada por hardware e não exportável em dispositivos com elemento seguro. Sem acesso ao seu dispositivo, o arquivo é ilegível. Capturas de tela e prévias na tela de aplicativos recentes são bloqueadas por padrão, e os backups na nuvem são desativados para impedir que sua agenda seja copiada para fora do dispositivo.</string>

    <!-- Sobre · Permissões -->
    <string name="about_permissions_title">Permissões e suas finalidades</string>
    <string name="about_perm_read_calendar">Somente leitura. Usada exclusivamente para copiar, quando solicitado, os eventos já armazenados neste dispositivo. Nenhum dado é alterado ou enviado para qualquer destino.</string>
    <string name="about_perm_notifications">Exibir seus lembretes.</string>
    <string name="about_perm_exact_alarm">Acionar um lembrete no minuto exato — um lembrete de calendário perde sua utilidade se chegar atrasado.</string>
    <string name="about_perm_boot">Reativar seus lembretes após a reinicialização do dispositivo (os alarmes não são mantidos após uma reinicialização).</string>
    <string name="about_perm_vibrate">Vibrar quando um lembrete for acionado, se essa opção estiver ativada.</string>
    <string name="about_perm_no_internet_name">INTERNET — não solicitada</string>
    <string name="about_perm_no_internet">O aplicativo não possui nenhuma permissão de acesso à rede. Os links desta página são abertos no navegador, fora do aplicativo.</string>

