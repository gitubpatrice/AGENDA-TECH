    <!-- About · Privacy -->
    <string name="about_privacy_title">Privacidad</string>
    <string name="about_privacy_card_title">100 % privada — cero vigilancia</string>
    <string name="about_privacy_body">Su agenda nunca sale de este teléfono. La app no declara ningún permiso de Internet: es técnicamente incapaz de enviar nada a ninguna parte.</string>
    <string name="about_badge_no_network">Sin red</string>
    <string name="about_badge_no_ads">Sin anuncios</string>
    <string name="about_badge_no_tracker">Sin rastreadores</string>
    <string name="about_badge_no_account">Sin cuenta</string>

    <!-- About · Features -->
    <string name="about_features_title">Funciones</string>
    <string name="about_feat_views_label">Vistas Mes, Semana, Día y Agenda</string>
    <string name="about_feat_views_desc">Deslice entre meses, vuelva a hoy, varios calendarios.</string>
    <string name="about_feat_recurrence_label">Eventos periódicos</string>
    <string name="about_feat_recurrence_desc">De diario a anual, intervalos personalizados, fecha de fin — edite una sola repetición o toda la serie.</string>
    <string name="about_feat_reminders_label">Recordatorios</string>
    <string name="about_feat_reminders_desc">Alarmas exactas, antelación personalizada, su propio tono. Se vuelven a programar tras un reinicio.</string>
    <string name="about_feat_import_label">Importar / exportar</string>
    <string name="about_feat_import_desc">Copie los eventos que ya están en este teléfono (Google, Exchange…) o intercambie archivos .ics — todo sin conexión.</string>
    <string name="about_feat_widgets_label">Widgets de pantalla de inicio</string>
    <string name="about_feat_widgets_desc">Próximos eventos y un icono compacto de la fecha.</string>
    <string name="about_feat_lock_label">Bloqueo con PIN / biometría</string>
    <string name="about_feat_lock_desc">Bloqueo opcional de toda la app, con protección contra intentos repetidos.</string>
    <string name="about_feat_encryption_label">Almacenamiento cifrado</string>
    <string name="about_feat_encryption_desc">Toda la base de datos está cifrada con AES-256; la clave nunca sale del hardware seguro del dispositivo.</string>
    <string name="about_feat_theme_label">Temas claro y oscuro</string>
    <string name="about_feat_theme_desc">Sigue al sistema, o fije uno. Números de semana, primer día de la semana, color predeterminado.</string>

    <!-- About · Security -->
    <string name="about_security_title">Seguridad</string>
    <string name="about_security_card_title">Cifrada en reposo</string>
    <string name="about_security_body">La base de datos (SQLCipher, AES-256) está cifrada con una clave aleatoria protegida por el Android Keystore — respaldado por hardware y no exportable en los dispositivos con elemento seguro. Sin su teléfono, el archivo es ilegible. Las capturas de pantalla y la vista previa en Recientes están bloqueadas por defecto, y las copias de seguridad en la nube están desactivadas, para que su agenda nunca se copie fuera del dispositivo.</string>

    <!-- About · Permissions -->
    <string name="about_permissions_title">Permisos y para qué</string>
    <string name="about_perm_read_calendar">Solo lectura. Sirve únicamente para copiar, cuando usted lo pide, los eventos ya guardados en este teléfono. Nunca se escribe nada en ellos ni se envían a ninguna parte.</string>
    <string name="about_perm_notifications">Mostrar sus recordatorios.</string>
    <string name="about_perm_exact_alarm">Lanzar un recordatorio en el minuto exacto — un recordatorio de calendario que llega tarde no sirve de nada.</string>
    <string name="about_perm_boot">Volver a programar sus recordatorios tras un reinicio (las alarmas no sobreviven a un reinicio).</string>
    <string name="about_perm_vibrate">Vibrar con un recordatorio, si lo activa.</string>
    <string name="about_perm_no_internet_name">INTERNET — no solicitado</string>
    <string name="about_perm_no_internet">La app no tiene ningún permiso de red. Los enlaces de esta página se abren en su navegador, fuera de la app.</string>

