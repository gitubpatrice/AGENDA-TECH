    <!-- Encrypted backup (.atbak) -->
    <string name="settings_backup">Versleutelde back-up</string>
    <string name="settings_backup_sub">De hele agenda exporteren of terugzetten als een met een wachtwoord beveiligd bestand</string>
    <string name="backup_title">Versleutelde back-up</string>
    <string name="backup_intro_title">Een volledige, versleutelde kopie</string>
    <string name="backup_intro_body">Het bestand bevat alles: kalenders, afspraken, herhalingen, locaties en herinneringen. Het is versleuteld met je wachtwoord (AES-256) — niemand kan het zonder dat wachtwoord openen, ook wij niet. Bewaar het waar je wilt: usb-stick, computer, cloud.</string>
    <string name="backup_warn_title">Het wachtwoord kan niet worden hersteld</string>
    <string name="backup_warn_body">Bij een back-up die je met de hand exporteert, wordt het nergens opgeslagen: als je het vergeet, is het bestand voorgoed onleesbaar. Bewaar het in een wachtwoordbeheerder. Automatische back-ups zijn de uitzondering — die moeten hun wachtwoord op deze telefoon bewaren, beschermd door de beveiligde hardware, om zonder jou te kunnen werken.</string>
    <string name="backup_export">Een back-up exporteren</string>
    <string name="backup_export_sub">Een versleuteld .atbak-bestand maken</string>
    <string name="backup_restore">Een back-up terugzetten</string>
