    <!-- About · Features -->
    <string name="about_features_title">Funzionalità</string>
    <string name="about_feat_views_label">Viste Mese, Settimana, Giorno e Agenda</string>
    <string name="about_feat_views_desc">Scorra tra i mesi, torni a oggi, più calendari.</string>
    <string name="about_feat_recurrence_label">Eventi ricorrenti</string>
    <string name="about_feat_recurrence_desc">Da ogni giorno a ogni anno, intervalli personalizzati, data di fine — modifichi una singola occorrenza o l\'intera serie.</string>
    <string name="about_feat_reminders_label">Promemoria</string>
    <string name="about_feat_reminders_desc">Sveglie esatte, anticipo personalizzato, la sua suoneria. Riprogrammati dopo un riavvio.</string>
    <string name="about_feat_import_label">Importazione / esportazione</string>
    <string name="about_feat_import_desc">Copi gli eventi già presenti su questo telefono (Google, Exchange…) o scambi file .ics — tutto offline.</string>
    <string name="about_feat_widgets_label">Widget per la schermata Home</string>
    <string name="about_feat_widgets_desc">Eventi in programma e un\'icona compatta della data.</string>
    <string name="about_feat_lock_label">Blocco con PIN / biometria</string>
    <string name="about_feat_lock_desc">Blocco facoltativo dell\'intera app, con protezione dai tentativi ripetuti.</string>
    <string name="about_feat_encryption_label">Archiviazione cifrata</string>
    <string name="about_feat_encryption_desc">L\'intero database è cifrato AES-256; la chiave non lascia mai l\'hardware sicuro del dispositivo.</string>
    <string name="about_feat_theme_label">Tema chiaro e scuro</string>
    <string name="about_feat_theme_desc">Segue il sistema, oppure lo imponga. Numeri delle settimane, primo giorno della settimana, colore predefinito.</string>

    <!-- About · Security -->
    <string name="about_security_title">Sicurezza</string>
    <string name="about_security_card_title">Cifrata a riposo</string>
    <string name="about_security_body">Il database (SQLCipher, AES-256) è cifrato con una chiave casuale protetta dall\'Android Keystore — supportato dall\'hardware e non esportabile sui dispositivi dotati di elemento sicuro. Senza il suo telefono, il file è illeggibile. Gli screenshot e l\'anteprima nelle app recenti sono bloccati per impostazione predefinita, e i backup nel cloud sono disattivati, così la sua agenda non viene mai copiata fuori dal dispositivo.</string>

    <!-- About · Permissions -->
    <string name="about_permissions_title">Autorizzazioni e perché</string>
    <string name="about_perm_read_calendar">Sola lettura. Serve unicamente a copiare, quando lo chiede, gli eventi già memorizzati su questo telefono. Non vi viene mai scritto nulla, e nulla viene mai inviato.</string>
    <string name="about_perm_notifications">Mostrare i suoi promemoria.</string>
    <string name="about_perm_exact_alarm">Far scattare un promemoria al minuto esatto — un promemoria di calendario in ritardo non serve a nulla.</string>
    <string name="about_perm_boot">Riprogrammare i suoi promemoria dopo un riavvio (le sveglie non sopravvivono a un riavvio).</string>
    <string name="about_perm_vibrate">Vibrare a un promemoria, se lo attiva.</string>
    <string name="about_perm_no_internet_name">INTERNET — non richiesta</string>
    <string name="about_perm_no_internet">L\'app non ha alcuna autorizzazione di rete. I link di questa pagina si aprono nel suo browser, fuori dall\'app.</string>

