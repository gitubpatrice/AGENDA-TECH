    <!-- About · Privacy -->
    <string name="about_privacy_title">Datenschutz</string>
    <string name="about_privacy_card_title">100 % privat — null Überwachung</string>
    <string name="about_privacy_body">Ihre Agenda verlässt dieses Telefon nie. Die App fordert überhaupt keine Internetberechtigung an — sie ist technisch nicht in der Lage, irgendetwas irgendwohin zu senden.</string>
