    <!-- About · Features -->
    <string name="about_features_title">Funktionen</string>
    <string name="about_feat_views_label">Monats-, Wochen-, Tages- und Agendaansicht</string>
    <string name="about_feat_views_desc">Zwischen Monaten wischen, zu heute springen, mehrere Kalender.</string>
    <string name="about_feat_recurrence_label">Wiederkehrende Termine</string>
    <string name="about_feat_recurrence_desc">Täglich bis jährlich, eigene Intervalle, Enddatum — einen einzelnen Termin oder die ganze Serie bearbeiten.</string>
    <string name="about_feat_reminders_label">Erinnerungen</string>
    <string name="about_feat_reminders_desc">Exakte Wecker, eigene Vorlaufzeit, Ihr eigener Klingelton. Nach einem Neustart wieder eingeplant.</string>
    <string name="about_feat_import_label">Import / Export</string>
    <string name="about_feat_import_desc">Die Termine übernehmen, die schon auf diesem Telefon sind (Google, Exchange…), oder .ics-Dateien austauschen — alles offline.</string>
    <string name="about_feat_widgets_label">Widgets für den Startbildschirm</string>
    <string name="about_feat_widgets_desc">Anstehende Termine und ein kompaktes Datumssymbol.</string>
    <string name="about_feat_lock_label">Sperre per PIN / Biometrie</string>
    <string name="about_feat_lock_desc">Optionale Sperre der ganzen App, mit Schutz gegen Durchprobieren.</string>
    <string name="about_feat_encryption_label">Verschlüsselte Speicherung</string>
    <string name="about_feat_encryption_desc">Die ganze Datenbank ist mit AES-256 verschlüsselt; der Schlüssel verlässt nie die sichere Hardware des Geräts.</string>
    <string name="about_feat_theme_label">Helles und dunkles Design</string>
    <string name="about_feat_theme_desc">Folgt dem System oder wird festgelegt. Kalenderwochen, erster Wochentag, Standardfarbe.</string>

    <!-- About · Security -->
    <string name="about_security_title">Sicherheit</string>
    <string name="about_security_card_title">Im Ruhezustand verschlüsselt</string>
    <string name="about_security_body">Die Datenbank (SQLCipher, AES-256) ist mit einem Zufallsschlüssel verschlüsselt, der vom Android Keystore geschützt wird — hardwaregestützt und nicht exportierbar auf Geräten mit Sicherheitselement. Ohne Ihr Telefon ist die Datei unlesbar. Bildschirmfotos und die Vorschau in der Übersicht der letzten Apps sind standardmäßig blockiert, und Cloud-Sicherungen sind deaktiviert, damit Ihre Agenda nie vom Gerät kopiert wird.</string>

    <!-- About · Permissions -->
    <string name="about_permissions_title">Berechtigungen und wozu</string>
    <string name="about_perm_read_calendar">Nur Lesezugriff. Dient ausschließlich dazu, auf Ihren Wunsch die Termine zu kopieren, die schon auf diesem Telefon gespeichert sind. Es wird nie etwas hineingeschrieben und nie etwas gesendet.</string>
    <string name="about_perm_notifications">Ihre Erinnerungen anzeigen.</string>
    <string name="about_perm_exact_alarm">Eine Erinnerung auf die Minute genau auslösen — eine Kalendererinnerung, die zu spät kommt, nützt nichts.</string>
    <string name="about_perm_boot">Ihre Erinnerungen nach einem Neustart wieder einplanen (Wecker überstehen keinen Neustart).</string>
    <string name="about_perm_vibrate">Bei einer Erinnerung vibrieren, wenn Sie es aktivieren.</string>
    <string name="about_perm_no_internet_name">INTERNET — nicht angefordert</string>
    <string name="about_perm_no_internet">Die App hat keinerlei Netzwerkberechtigung. Links auf dieser Seite öffnen sich in Ihrem Browser, außerhalb der App.</string>

