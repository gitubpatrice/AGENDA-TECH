<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme. The visible UI is drawn by Compose (AgendaTechTheme); this only sets the
         window background so there is no flash before the first composition. -->
    <style name="Theme.AgendaTech" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen (androidx.core:core-splashscreen). Shows the launcher glyph on the brand
         background, then hands off to Theme.AgendaTech.

         The icon is @drawable/splash_icon and not ic_launcher_foreground directly: the splash draws
         its icon inside a CIRCLE, so a full-bleed rounded square loses its four corners and the mark
         arrives as a disc. splash_icon is the same logo, inset into the circular safe zone — see the
         comment in that file for the geometry and for why the launcher icon is left alone. -->
    <style name="Theme.AgendaTech.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.AgendaTech</item>
    </style>
</resources>
